package view

import "fmt"

templ PasswordResetEmail(domain string, token string) {
	<html>
		<body>
			<h1>Reset Your Password</h1>
			<p>Click the link below to reset your password for the Survivor App.</p>
			<p>
				<a href={ templ.URL(fmt.Sprintf("https://%s/reset-password?token=%s", domain, token)) }>Reset Password</a>
			</p>
			<p>This link will expire in 20 minutes.</p>
			<p>If you did not request a password reset, please ignore this email.</p>
		</body>
	</html>
}
