package view
import "survivor-app/internal/models"

templ Login() {
	@LoginWithErrors("")
}

templ ForgotPassword() {
	@ForgotPasswordForm(false)
}

templ LoginWithErrors(errorMsg string) {
	<div id="login-form" class="flex justify-center">
		<div class="max-w-md w-full card bg-base-100 shadow-xl p-8 border border-base-300">
			<h2 class="text-3xl font-bold mb-2 text-primary text-center">Login</h2>
			<p class="mb-6 text-base-content/70 text-center">Enter your credentials to continue.</p>
                
			<form hx-post="/login" hx-target="#login-form" 
			hx-swap="outerHTML">
				if errorMsg != "" {
						<div role="alert" class="alert alert-error">
							<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<span>{ errorMsg }</span>
						</div>
				}
					<div class="form-control">
						<label class="label">
							<span class="label-text">Username / Email Address</span>
						</label>
						<input type="text" name="slug" placeholder="username" class="input input-bordered" required/>
					</div>
					<div class="form-control">
						<label class="label">
							<span class="label-text">Password</span> 
						</label>
						<input type="password" name="password" placeholder="password" class="input input-bordered" required/>
						<p class="mt-2.5 text-xs text-body text-right">
							<a class="underline hover:no-underline" 
								href="/forgot-password"
								hx-get="/forgot-password"
								hx-target="#login-form"
								hx-swap="innerHTML"
								hx-push-url="true">forgot password?</a>
						</p>
					</div>
					<div class="form-control mt-4">
						<button class="btn btn-primary">Login</button>
					</div>
			</form>
		</div>
	</div>
}

templ ForgotPasswordForm(posted bool) {
	<div id="login-form" class="flex justify-center">
		<div class="max-w-md w-full card bg-base-100 shadow-xl p-8 border border-base-300">
			<h2 class="text-3xl font-bold mb-2 text-primary text-center">Password Reset</h2>
			<p class="mb-6 text-base-content/70 text-center">Enter your email address to recieve a reset link</p>
			if posted {
				<div class="text-center p-4">
					<p class="text-base-content/80">If an account with that email exists, a password reset link has been sent.</p>
				</div>
			} else {
				<form hx-post="/forgot-password" hx-target="#login-form" hx-swap="outerHTML">
					<div class="form-control">
						<label class="label">
							<span class="label-text">Email Address</span>
						</label>
						<input type="text" name="email" placeholder="someone@blueelm.com" class="input input-bordered" required/>
					</div>
					<div class="form-control mt-6">
						<button class="btn btn-primary">Send Link</button>
					</div>
				</form>
			}
		</div>
	</div>
}

templ ResetPassword(user models.User, errorMsg string, token string) {
	<div id="login-form" class="flex justify-center">
		<div class="max-w-md w-full card bg-base-100 shadow-xl p-8 border border-base-300">
			<h2 class="text-3xl font-bold mb-2 text-primary text-center">Password Reset</h2>
		<form hx-post="/reset-password" hx-target="#login-form" hx-swap="outerHTML">
			if errorMsg != "" {
					<div role="alert" class="alert alert-error">
						<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span>{ errorMsg }</span>
					</div>
				}
				<input type="hidden" name="token" value={ token }/>
				<div class="form-control">
					<label class="label">
						<span class="label-text">Email Address</span>
					</label>
					<input type="text" name="email" value={ *user.Email } disabled class="input input-bordered" required/>
				</div>
				<div class="form-control">
						<label class="label">
							<span class="label-text">Password</span> 
						</label>
					<input type="password" name="password" placeholder="password (>= 16 characters)" class="input input-bordered" required/>
				</div>
				<div class="form-control">
						<label class="label">
							<span class="label-text">Password</span> 
						</label>
					<input type="password" name="password2" placeholder="confirm password" class="input input-bordered" required/>
				</div>
				<div class="form-control mt-4">
					<button class="btn btn-primary">Set Password</button>
				</div>
		</form>
		</div>
	</div>
}

templ PasswordResetSuccess() {
	<div id="login-form" class="flex justify-center">
		<div class="max-w-md w-full card bg-base-100 shadow-xl p-8 border border-base-300 text-center">
			<h2 class="text-3xl font-bold mb-2 text-primary">Success!</h2>
			<p class="mb-6 text-base-content/70">Your password has been reset.</p>
			<a href="/login" class="btn btn-primary" hx-boost="false"
			hx-get="/login"
								hx-target="#login-form"
								hx-swap="innerHTML"
								hx-push-url="true">Return to Login</a>
		</div>
	</div>
}